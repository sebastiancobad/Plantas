# ChemScale Environment Configuration
# Copy to .env and adjust values

# Database
DATABASE_URL=postgresql://chemscale:chemscale@localhost:5432/chemscale

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Application
DEBUG=true
APP_NAME=ChemScale
